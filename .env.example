# ── Núcleo ────────────────────────────────────────────────────────────────
# offline | openai  (offline = determinístico, sem chave e sem rede)
LLM_PROVIDER=offline
LLM_MODEL=offline-template
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=600
LLM_TIMEOUT_MS=30000

# Ollama local (use LLM_PROVIDER=openai + base abaixo)
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b-instruct

# ── Servidor ──────────────────────────────────────────────────────────────
PORT=3110
HOST=127.0.0.1
DB_PATH=data/agent.sqlite
CATALOG_PATH=data/catalog.csv
FAQ_PATH=data/faq.md

# ── Adapter Bot Framework (caminho oficial / Azure Bot Service) ───────────
# Preencha com o App ID e o secret do Azure Bot; endpoint: POST /api/messages
BOT_APP_ID=
BOT_APP_SECRET=
BOT_TENANT_ID=botframework.com
BOT_SKIP_AUTH=1          # 1 apenas em dev local; em produção o JWT é validado

# ── Adapter Teams Web (Playwright, uso pessoal/local) ─────────────────────
# ATENÇÃO: automatizar o Teams Web viola os termos da Microsoft para uso
# não assistido/em massa. Use o adapter Bot Framework para produção.
TEAMS_WEB_ENABLE=0
TEAMS_WEB_URL=https://teams.microsoft.com/v2/
TEAMS_WEB_USER_DATA_DIR=.telemetry/teams-profile
TEAMS_WEB_HEADLESS=1
TEAMS_WEB_CHANNEL=chrome    # chrome | msedge | chromium
TEAMS_WEB_POLL_MS=15000
TEAMS_WEB_CHATS=            # vazio = todos os chats; ou "Comercial,Suporte"
TEAMS_WEB_MENTION_ONLY=1    # em grupo só responde se mencionado
